{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.membrane.invalid/contracts/vote-log.schema.json",
  "title": "Proposed Membrane signed event v1 — REQUIRES constitution Article I amendment",
  "description": "Cross-node event carries item identity and bounded protocol metadata only. No URLs, titles, body, rationale, embeddings or scores. Not approved for implementation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "author_id", "seq", "item_id", "issued_ms", "signature"],
  "properties": {
    "version": {"const": 1},
    "kind": {"enum": ["vote", "poll_invite"]},
    "author_id": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of pinned Ed25519 public key"},
    "seq": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "item_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "issued_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "poll_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "vote": {"enum": ["keep", "kill", "abstain"]},
    "confidence_bp": {"type": "integer", "minimum": 0, "maximum": 10000},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$", "description": "Unpadded base64url of 64 Ed25519 signature bytes"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "vote"}}, "required": ["kind"]},
      "then": {"required": ["vote", "confidence_bp"]},
      "else": {"required": ["poll_id"], "not": {"anyOf": [{"required": ["vote"]}, {"required": ["confidence_bp"]}]}}
    }
  ]
}
